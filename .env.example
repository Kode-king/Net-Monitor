# Copy to .env.local and fill in. NEVER commit .env.local.

# ---- Security (required in production) ----
# Long random string (>=32 chars). Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Optional: separate key for encrypting SNMP secrets at rest. Falls back to AUTH_SECRET.
# Changing it makes previously-encrypted community/keys unreadable — re-enter them.
# SECRET_KEY=

# 1 = mark the session cookie Secure (use when served over HTTPS — recommended).
# 0 = plain-HTTP LAN only.
COOKIE_SECURE=1

# ---- Poller ----
RUN_POLLER_IN_APP=0
DEFAULT_POLL_INTERVAL=30
RETENTION_DAYS=14
AUDIT_RETENTION_DAYS=180

# ---- Email (critical alerts + scheduled report) ----
# Leave SMTP_HOST empty to disable email (browser alarm still works).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=net-monitor@example.org
# SMTP_TLS_INSECURE=1
